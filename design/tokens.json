{
  "$comment": "House Pour — Lucian Labs look B. Single source for every platform. Values are copied from https://lucianlabs.ca/branding/brands.json (looks.house-pour) and house-pour.css; do not retype from memory, re-run `node build.mjs --pull` to diff against upstream. px values are CSS px; native builds read them as pt (iOS) / dp (Android). rem values assume 16px.",
  "name": "House Pour",
  "slug": "house-pour",
  "version": "1.0.0",
  "upstream": {
    "spec": "https://lucianlabs.ca/branding/house-pour.md",
    "stylesheet": "https://lucianlabs.ca/branding/house-pour.css",
    "tokens": "https://lucianlabs.ca/branding/brands.json",
    "rules": "https://lucianlabs.ca/branding/AGENT.md"
  },
  "color": {
    "bg": "#f7f5ef",
    "bg2": "#f1eee6",
    "panel": "#fffefa",
    "ink": "#262319",
    "muted": "#71695a",
    "faint": "#a79f8d",
    "line": "rgba(38, 35, 25, 0.11)",
    "line2": "rgba(38, 35, 25, 0.2)",
    "accent": "#a4813b",
    "accent2": "#c9a961",
    "accentSoft": "rgba(164, 129, 59, 0.14)",
    "good": "#3c7a52",
    "bad": "#a03d38",
    "violet": "#8f6fc7",
    "scrim": "rgba(38, 35, 25, 0.4)",
    "primaryGradientStart": "#b3903f",
    "primaryGradientEnd": "#97742f",
    "primaryText": "#fffdf6",
    "charcoalGradientStart": "#35311f",
    "charcoalGradientEnd": "#23211a",
    "charcoalText": "#f6f2e8",
    "inputBg": "#fffef9",
    "toastBg": "#26231a",
    "toastText": "#f6f2e8",
    "toastLine": "rgba(255, 253, 246, 0.12)",
    "topbarBg": "rgba(250, 248, 243, 0.85)",
    "backdropTop": "#faf8f3",
    "backdropMid": "#f5f2ea",
    "backdropBottom": "#f2eee4",
    "washGold": "rgba(201, 169, 97, 0.10)",
    "washViolet": "rgba(143, 111, 199, 0.05)"
  },
  "radius": {
    "card": 16,
    "input": 12,
    "media": 12,
    "pill": 999
  },
  "border": {
    "width": 1
  },
  "shadow": {
    "$comment": "One shadow on raised surfaces. Two layers: contact line + long soft cast.",
    "contact": { "x": 0, "y": 1, "blur": 2, "color": "rgba(38, 35, 25, 0.04)" },
    "cast": { "x": 0, "y": 14, "blur": 34, "spread": -18, "color": "rgba(38, 35, 25, 0.18)" },
    "primaryButton": { "x": 0, "y": 10, "blur": 22, "spread": -12, "color": "rgba(164, 129, 59, 0.65)" },
    "charcoalButton": { "x": 0, "y": 10, "blur": 22, "spread": -14, "color": "rgba(38, 35, 25, 0.55)" },
    "toast": { "x": 0, "y": 16, "blur": 36, "spread": -12, "color": "rgba(38, 35, 25, 0.5)" }
  },
  "space": {
    "$comment": "4px rhythm. Cards pad 20, stack 16. App column 540 max with 14 side padding. List rows 14 vertical. Kebab (PRODUCT 2.6): a 4 dot with a 3 gap = an 18 column inside touchMin. Menu: 240 wide (6 x touchMin) as a floor, dismissed by a swipe past 40 (one hit target).",
    "columnMax": 540,
    "columnSide": 14,
    "cardPad": 20,
    "cardGap": 16,
    "rowPad": 14,
    "topbarY": 14,
    "topbarX": 22,
    "topbarBottom": 18,
    "buttonY": 14,
    "buttonX": 20,
    "buttonSmY": 9,
    "buttonSmX": 16,
    "inputY": 13,
    "inputX": 15,
    "inputBottom": 12,
    "labelBottom": 6,
    "pillY": 4,
    "pillX": 10,
    "tabsPad": 4,
    "tabsGap": 4,
    "tabY": 10,
    "tabX": 8,
    "tabsBottom": 16,
    "btnRowGap": 10,
    "rowGap": 10,
    "touchMin": 40,
    "kebabDot": 4,
    "kebabDotGap": 3,
    "menuWidth": 240,
    "menuDismissDrag": 40,
    "avatarRow": 36,
    "avatarProfile": 72,
    "bottomSafe": 96
  },
  "font": {
    "$comment": "PostScript names are what SwiftUI Font.custom() and Android need. Body is Avenir Next on Apple platforms (system), Roboto/sans-serif elsewhere — the fallback is allowed by AGENT.md; the declared face is what matters.",
    "display": {
      "family": "Cormorant Garamond",
      "files": {
        "500": "CormorantGaramond-Medium",
        "600": "CormorantGaramond-SemiBold",
        "700": "CormorantGaramond-Bold",
        "500i": "CormorantGaramond-MediumItalic"
      },
      "css": "'Cormorant Garamond', 'Times New Roman', Georgia, serif"
    },
    "brand": {
      "family": "Kaushan Script",
      "files": { "400": "KaushanScript-Regular" },
      "css": "'Kaushan Script', cursive"
    },
    "mono": {
      "family": "Inconsolata",
      "files": { "400": "Inconsolata-Regular", "600": "Inconsolata-SemiBold" },
      "css": "'Inconsolata', 'IBM Plex Mono', monospace"
    },
    "body": {
      "family": "Avenir Next",
      "ios": { "400": "AvenirNext-Regular", "500": "AvenirNext-Medium", "600": "AvenirNext-DemiBold", "700": "AvenirNext-Bold" },
      "android": "sans-serif",
      "css": "'Avenir Next', Avenir, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    }
  },
  "type": {
    "$comment": "size in px (= pt/sp). tracking in em. weight numeric. face is a key of font.",
    "wordmark":    { "face": "brand",   "size": 48,   "weight": 400, "lineHeight": 1.05, "tracking": 0 },
    "brand":       { "face": "brand",   "size": 27.2, "weight": 400, "lineHeight": 1.0,  "tracking": 0 },
    "h1":          { "face": "display", "size": 33.6, "weight": 600, "lineHeight": 1.12, "tracking": 0.01 },
    "h2":          { "face": "display", "size": 25.6, "weight": 600, "lineHeight": 1.12, "tracking": 0.01 },
    "figure":      { "face": "display", "size": 57.6, "weight": 600, "lineHeight": 1.0,  "tracking": 0.01, "liningNums": true },
    "totals":      { "face": "display", "size": 20,   "weight": 600, "lineHeight": 1.2,  "tracking": 0 },
    "totalsAmount":{ "face": "display", "size": 21.6, "weight": 600, "lineHeight": 1.2,  "tracking": 0 },
    "sectionMark": { "face": "body",    "size": 11.2, "weight": 700, "lineHeight": 1.2,  "tracking": 0.22, "uppercase": true },
    "fieldLabel":  { "face": "body",    "size": 10.56,"weight": 700, "lineHeight": 1.2,  "tracking": 0.18, "uppercase": true },
    "button":      { "face": "body",    "size": 12.48,"weight": 700, "lineHeight": 1.2,  "tracking": 0.14, "uppercase": true },
    "buttonSm":    { "face": "body",    "size": 10.56,"weight": 700, "lineHeight": 1.2,  "tracking": 0.14, "uppercase": true },
    "tab":         { "face": "body",    "size": 11.2, "weight": 700, "lineHeight": 1.2,  "tracking": 0.16, "uppercase": true },
    "pill":        { "face": "body",    "size": 9.92, "weight": 700, "lineHeight": 1.2,  "tracking": 0.14, "uppercase": true },
    "body":        { "face": "body",    "size": 16,   "weight": 400, "lineHeight": 1.5,  "tracking": 0 },
    "bodyStrong":  { "face": "body",    "size": 16,   "weight": 600, "lineHeight": 1.5,  "tracking": 0 },
    "small":       { "face": "body",    "size": 13.6, "weight": 400, "lineHeight": 1.5,  "tracking": 0 },
    "toast":       { "face": "body",    "size": 13.6, "weight": 600, "lineHeight": 1.3,  "tracking": 0 },
    "input":       { "face": "body",    "size": 16,   "weight": 400, "lineHeight": 1.3,  "tracking": 0 },
    "mono":        { "face": "mono",    "size": 14.4, "weight": 400, "lineHeight": 1.5,  "tracking": 0 },
    "monoSmall":   { "face": "mono",    "size": 12.8, "weight": 400, "lineHeight": 1.5,  "tracking": 0 }
  },
  "motion": {
    "colorMs": 150,
    "pressMs": 50,
    "toastMs": 200,
    "pressTranslateY": 1,
    "$comment": "150ms ease on colour/filter/border. :active presses 1px. Toasts fade. Nothing animates on load."
  }
}
