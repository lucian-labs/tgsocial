// Copy to Secrets.xcconfig (gitignored) and fill in from https://my.telegram.org/apps
TG_API_ID = 0
TG_API_HASH = replace_me

// Optional: the origin of a public reader you host yourself (PRODUCT §2.13, PUBLIC.md).
// Leave it unset unless you are actually serving /u/, /f/ and /n/ somewhere — with no origin,
// `Copy Link` copies the t.me link, which needs no server of yours. Scheme and host only: no
// path, no trailing slash. Anything else is refused and sharing stays on t.me.
//
// Mind the `/$()/`. xcconfig starts a comment at `//`, so writing `https://tgsocial.example.com`
// here sets the value to `https:` and comments out the host. `$()` expands to nothing and splits
// the slash pair, so the parser sees no comment and the build setting resolves to the full origin.
// TGS_PUBLIC_ORIGIN = https:/$()/tgsocial.example.com

// Optional, for `make upload`: App Store Connect API key id and issuer id (the .p8 stays in ~/.private_keys)
ASC_API_KEY =
ASC_API_ISSUER =

// Optional, for a fork's own Bluesky client (PROTOCOL §12.7, docs/HOSTING.md §7). Set both or
// neither. The redirect's scheme is the client_id's host reversed, and the build registers exactly
// that scheme (scripts/redirect-scheme.sh) so the browser can hand the sign-in back; a half-set or
// mismatched pair fails the build. Leave both unset to use the reference client.
// TGS_ATPROTO_CLIENT_ID = https:/$()/tgsocial.example.com/client-metadata.json
// TGS_ATPROTO_REDIRECT = com.example.tgsocial:/tgsocial/oauth/callback
