# Copy to secrets.properties (gitignored) and fill in from https://my.telegram.org/apps
TG_API_ID=0
TG_API_HASH=replace_me

# Optional (PRODUCT §2.13). The origin of a public reader you host yourself — see PUBLIC.md and
# web/nginx-public.conf. Set it and `Copy Link` copies https://<origin>/f/<channel>; leave it out
# and `Copy Link` copies the t.me link, which needs no server of your own.
# Scheme and host only — http:// or https://, no path, and a bare hostname is not enough. The public
# routes are served from the root, so anything else builds a link the reader cannot answer: the app
# refuses such a value, says so in logcat, and shares the t.me link instead.
# TGS_PUBLIC_ORIGIN=https://tgsocial.example.org
